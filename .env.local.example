## Search engine ownership verification tokens (optional until webmaster accounts are ready)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=replace-with-google-search-console-token
NEXT_PUBLIC_BING_SITE_VERIFICATION=replace-with-bing-webmaster-token

# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key-here
# Server-only key: use the current `sb_secret_...` key where available.
# A legacy `eyJ...` service-role JWT must have current iat/nbf/exp claims.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-secret-key-here

# Optional: Cloudinary for image hosting
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Admin login. Generate a unique PBKDF2-SHA256 hash and random secrets before deployment.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=your-pbkdf2-password-hash
ADMIN_PASSWORD_SALT=your-random-password-salt
ADMIN_SESSION_SECRET=your-long-random-session-secret
